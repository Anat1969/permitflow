{
  "name": "Permit",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "permit_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05d9\u05ea\u05e8",
      "enum": [
        "\u05d4\u05d9\u05ea\u05e8 \u05d1\u05e0\u05d9\u05d9\u05d4",
        "\u05d4\u05d9\u05ea\u05e8 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d7\u05d5\u05e8\u05d2",
        "\u05d4\u05d9\u05ea\u05e8 \u05ea\u05de\"\u05d0 38",
        "\u05d4\u05d9\u05ea\u05e8 \u05d4\u05e8\u05d9\u05e1\u05d4",
        "\u05d4\u05d9\u05ea\u05e8 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd",
        "\u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e2\u05e1\u05e7"
      ]
    },
    "status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "enum": [
        "\u05d8\u05d9\u05d5\u05d8\u05d4",
        "\u05d4\u05d5\u05d2\u05e9",
        "\u05d1\u05d1\u05d3\u05d9\u05e7\u05d4",
        "\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05ea\u05d9\u05e7\u05d5\u05df",
        "\u05d0\u05d5\u05e9\u05e8",
        "\u05e0\u05d3\u05d7\u05d4"
      ],
      "default": "\u05d8\u05d9\u05d5\u05d8\u05d4"
    },
    "address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea"
    },
    "city": {
      "type": "string",
      "title": "\u05e2\u05d9\u05e8"
    },
    "applicant_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d1\u05e7\u05e9"
    },
    "applicant_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05de\u05d1\u05e7\u05e9"
    },
    "architect_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05d3\u05e8\u05d9\u05db\u05dc"
    },
    "submission_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d2\u05e9\u05d4"
    },
    "expected_approval_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e6\u05e4\u05d5\u05d9"
    },
    "current_stage": {
      "type": "string",
      "title": "\u05e9\u05dc\u05d1 \u05e0\u05d5\u05db\u05d7\u05d9",
      "enum": [
        "\u05d4\u05db\u05e0\u05ea \u05de\u05e1\u05de\u05db\u05d9\u05dd",
        "\u05d4\u05d2\u05e9\u05d4 \u05dc\u05d5\u05d5\u05e2\u05d3\u05d4 \u05de\u05e7\u05d5\u05de\u05d9\u05ea",
        "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05db\u05e0\u05d9\u05ea",
        "\u05e9\u05d9\u05de\u05d5\u05e2/\u05d3\u05d9\u05d5\u05df",
        "\u05ea\u05e0\u05d0\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd",
        "\u05d0\u05d9\u05e9\u05d5\u05e8 \u05e1\u05d5\u05e4\u05d9"
      ],
      "default": "\u05d4\u05db\u05e0\u05ea \u05de\u05e1\u05de\u05db\u05d9\u05dd"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "documents": {
      "type": "array",
      "title": "\u05de\u05e1\u05de\u05db\u05d9\u05dd",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "images": {
      "type": "array",
      "title": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "priority": {
      "type": "string",
      "title": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea",
      "enum": [
        "\u05e0\u05de\u05d5\u05db\u05d4",
        "\u05e8\u05d2\u05d9\u05dc\u05d4",
        "\u05d2\u05d1\u05d5\u05d4\u05d4",
        "\u05d3\u05d7\u05d5\u05e4\u05d4"
      ],
      "default": "\u05e8\u05d2\u05d9\u05dc\u05d4"
    },
    "estimated_cost": {
      "type": "number",
      "title": "\u05e2\u05dc\u05d5\u05ea \u05de\u05e9\u05d5\u05e2\u05e8\u05ea (\u20aa)"
    },
    "area_sqm": {
      "type": "number",
      "title": "\u05e9\u05d8\u05d7 (\u05de\"\u05e8)"
    }
  },
  "required": [
    "title",
    "permit_type",
    "status",
    "address",
    "city"
  ]
}